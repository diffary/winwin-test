# Copy to .env and adjust. .env is git-ignored.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=appdb

# Must be at least 32 characters (HS256 key).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Shared secret between auth-api and data-api.
INTERNAL_TOKEN=change-me-internal-token
